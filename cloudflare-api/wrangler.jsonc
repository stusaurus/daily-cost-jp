{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-cost-api",
  "main": "src/safe-index.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "keep_vars": true,
  "secrets": {
    "required": [
      "RAKUTEN_APPLICATION_ID",
      "RAKUTEN_ACCESS_KEY",
      "RAKUTEN_AFFILIATE_ID"
    ]
  },
  "observability": {
    "enabled": true
  }
}
